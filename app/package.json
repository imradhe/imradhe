{
  "name": "imradhe-com",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/scripts/seed.js",
    "admin": "node --env-file-if-exists=.env server/scripts/admin.js",
    "test": "node --test --test-concurrency=1 server/tests/*.test.js",
    "test:ui": "vitest run",
    "check": "npm run build && npm test && npm run test:ui"
  },
  "dependencies": {
    "@google/model-viewer": "^4.1.0",
    "chess.js": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "html-react-parser": "^5.2.17",
    "marked": "^16.4.1",
    "mongoose": "^8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
