# Enable URL Rewriting
Options +FollowSymLinks
RewriteEngine On

# Legacy sub-sites that moved to their own subdomains
RewriteRule ^aibro/?$ https://aibro.imradhe.com/aibro [R=302,L]
RewriteRule ^adcast/?$ https://adcast.imradhe.com/adcast [R=302,L]

# Send everything that is not a real file or directory to the router.
# QSA keeps the original query string, so /blog?page=2 reaches PHP intact.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
