PORT=8080
APP_URL=http://localhost:8080
MONGODB_URI=mongodb://127.0.0.1:27017/imradhe
NODE_ENV=development
# Set to 1 only behind exactly one trusted reverse proxy (e.g. Dokploy).
TRUST_PROXY=0
# Public registration can be disabled after creating your account.
ALLOW_REGISTRATION=true
# Optional ASR upstream. Audio is forwarded only on explicit form submission.
ASR_URL=
ASR_TOKEN=
